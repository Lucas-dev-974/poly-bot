# Poll active 15m markets every N ms (2000–5000 recommended)
POLL_INTERVAL_MS=2000

# Markets to trade (comma-separated slug prefixes)
MARKET_SLUG_PREFIXES=btc-updown-15m,eth-updown-15m

# Reverse side: cheap limit = PAIR_TARGET_COST − hedge ask (0.80 → 0.15).
# Floor 0.07: do not lift a dying 5c ask.
CHEAP_BUY_MIN=0.07
CHEAP_BUY_MAX=0.25
CHEAP_ORDER_USDC=1
PAIR_TARGET_COST=0.95

# Hedge side: buy the favorite only when its ask is already in this band.
# No new cheap is posted if the favorite asks above EXPENSIVE_BUY_MAX
# (a limit far below a 0.97 ask is not a cover).
ENABLE_EXPENSIVE_HEDGE=true
EXPENSIVE_BUY_MIN=0.85
EXPENSIVE_BUY_MAX=0.95
# USDC budget of the hedge order (same sizing as CHEAP_ORDER_USDC).
# 5 USDC at 0.81 → ~6.17 shares. Must still meet CLOB mins (5 shares, $1).
EXPENSIVE_ORDER_USDC=20
# Hedge at min(bestAsk, EXPENSIVE_BUY_MAX). Cheap = PAIR_TARGET_COST − that price.
# FOK = hedge after a cheap fill. GTC = rest the hedge beside the cheap.
EXPENSIVE_ORDER_TYPE=FOK
PAIR_COST_MAX=1.02

# Max shares per order
MAX_SHARES_PER_ORDER=20

# Max simultaneous open positions per outcome side per market (1 = one position per side at a time)
MAX_OPEN_POSITIONS_PER_SIDE=1

# Hard cap on total open + resting exposure (USDC).
# Un cheap (CHEAP_ORDER_USDC) + un hedge (EXPENSIVE_ORDER_USDC).
MAX_EXPOSURE_USDC=45

# Only trade when this many minutes remain in the 15m window (0-15)
MINUTES_BEFORE_CLOSE_MIN=0
MINUTES_BEFORE_CLOSE_MAX=15
# Ne pas acheter si la clôture du marché est dans moins de X minutes (vide = désactivé)
MIN_MINUTES_BEFORE_CLOSE_TO_BUY=

# Safety: keep true until you intentionally go live
DRY_RUN=true

# Mode "live en lecture seule" : DRY_RUN=false + READONLY_LIVE=true
# Le bot lit le solde reel (BalanceTracker) et affiche les marches, mais
# ne place AUCUN ordre. Utile pour verifier les fonds avant de trader.
READONLY_LIVE=false

# Web dashboard (read-only, SSE)
ENABLE_DASHBOARD=true
DASHBOARD_PORT=3105

# Simulated starting capital for DRY_RUN (ignored when live)
SIMULATED_CAPITAL=50

# SQLite persistence
PERSISTENCE_ENABLED=true
# SQLite dry-run (simulation) history: positions, pairs, capital, events, stats
DB_PATH=data/bot.db
# Overrides UI (dashboard) persisted here — merged over .env on startup
# data/bot-settings.json
# SQLite live trading (séparé pour préserver l'historique respectif)
DB_PATH_LIVE=data/bot-live.db

# Rétention des snapshots de marché pollés (en jours, pruné toutes les 1h)
# Marchés découverts (market_snapshots) — défaut 7 jours
MARKET_SNAPSHOT_RETENTION_DAYS=7
# Order books: bestBid/bestAsk/size (book_snapshots) — défaut 3 jours (plus volumineux)
BOOK_SNAPSHOT_RETENTION_DAYS=3
# Opportunités d'arbitrage détectées (opportunity_snapshots) — défaut 7 jours
OPPORTUNITY_SNAPSHOT_RETENTION_DAYS=7

# --- Simulation dryrun (realistic fill + settlement) ---
SIM_FILL_PROBABILITY_NON_MARKETABLE=0.3   # P(fill) de base si limite < bestAsk
SIM_RESOLVE_DELAY_SECONDS=5               # délai avant lookup de résolution (réduit pour détection rapide)
SIM_RESOLVE_RETRY_INTERVAL_MS=5000        # intervalle entre tentatives API Gamma (au lieu de 30s codé en dur)
SIM_RESOLVE_MAX_RETRIES=5                 # tentatives API Gamma
# none recommandé (obligatoire en live). probabilistic = RNG, dry-run only.
SIM_RESOLVE_FALLBACK=none
SIM_MAX_RETRY_ATTEMPTS=20                 # retries de fill avant abandon
# En mode LIVE (DRY_RUN=false), recommande SIM_RESOLVE_FALLBACK=none pour ne
# jamais résoudre une position réelle sur un tirage probabiliste : on préfère
# laisser la position "open" jusqu'à la confirmation de l'API Gamma.
SIM_RANDOM_SEED=                          # seed pour fallback reproductible (vide = aléatoire)
# Skip new cheap unless the favorite ask is in [EXPENSIVE_BUY_MIN, EXPENSIVE_BUY_MAX].
# Does not guarantee the hedge fills; an unhedged fill is counted as directional.
SIM_REQUIRE_COVERED_PAIR=true

# CLOB / wallet (required when DRY_RUN=false)
PRIVATE_KEY=0x...
FUNDER_ADDRESS=0x...
SIGNATURE_TYPE=3
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137

# Optional: reuse existing API credentials instead of deriving
# CLOB_API_KEY=
# CLOB_SECRET=
# CLOB_PASSPHRASE=

# --- Polymarket Relayer (Builder credentials) ---
# Required for deposit-wallet (V2) on-chain actions: redeem, split, merge.
# The relayer dispatches EIP-712 signed batches gaslessly through the wallet.
# Get them from https://polymarket.com/settings?tab=builder
# BUILDER_API_KEY=<uuid>
# BUILDER_SECRET=<base64>
# BUILDER_PASSPHRASE=<hex>
# RELAYER_HOST=https://relayer-v2.polymarket.com

# --- Polymarket Relayer API key (optional, preferred) ---
# Dedicated key that grants UNLIMITED daily relayer transactions for the
# owning wallet, bypassing the Builder-tier daily quota (100 → 10 000 tx/day).
# Required only if you hit "quota exceeded: 0 units remaining" 429 errors.
# Create one at polymarket.com → Settings → API Keys → Relayer API Keys.
# RELAYER_API_KEY=<uuid>
# RELAYER_API_KEY_ADDRESS=0x<signer-address>   # EOA that owns the key (defaults to FUNDER_ADDRESS)
