# Secrets + infra only. Strategy parameters live in data/bot-settings.json
# (dashboard). Copy bot-settings.example.json there on first setup.
# Leftover CHEAP_* / EXPENSIVE_* / POLL_* env vars are ignored.

# Safety: keep true until you intentionally go live
DRY_RUN=true

# Mode "live en lecture seule" : DRY_RUN=false + READONLY_LIVE=true
# Le bot lit le solde réel (BalanceTracker) et affiche les marchés, mais
# ne place AUCUN ordre. Utile pour vérifier les fonds avant de trader.
READONLY_LIVE=false

# Web dashboard (SSE). Strategy edits in the UI write data/bot-settings.json.
ENABLE_DASHBOARD=true
DASHBOARD_PORT=3105

# SQLite persistence
PERSISTENCE_ENABLED=true
# SQLite dry-run (simulation) history: positions, pairs, capital, events, stats
DB_PATH=data/bot.db
# SQLite live trading (séparé pour préserver l'historique respectif)
DB_PATH_LIVE=data/bot-live.db

# Rétention des snapshots de marché pollés (en jours, pruné toutes les 1h)
# Marchés découverts (market_snapshots) — défaut 7 jours
MARKET_SNAPSHOT_RETENTION_DAYS=7
# Order books: bestBid/bestAsk/size (book_snapshots) — défaut 3 jours (plus volumineux)
BOOK_SNAPSHOT_RETENTION_DAYS=3
# Opportunités d'arbitrage détectées (opportunity_snapshots) — défaut 7 jours
OPPORTUNITY_SNAPSHOT_RETENTION_DAYS=7

# CLOB / wallet (required when DRY_RUN=false)
PRIVATE_KEY=0x...
FUNDER_ADDRESS=0x...
SIGNATURE_TYPE=3
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
GAMMA_API_HOST=https://gamma-api.polymarket.com
DATA_API_HOST=https://data-api.polymarket.com

# Optional: reuse existing API credentials instead of deriving
# CLOB_API_KEY=
# CLOB_SECRET=
# CLOB_PASSPHRASE=

# Redeem winning positions automatically via the relayer
AUTO_REDEEM_WINNERS=false

# --- Polymarket Relayer (Builder credentials) ---
# Required for deposit-wallet (V2) on-chain actions: redeem, split, merge.
# The relayer dispatches EIP-712 signed batches gaslessly through the wallet.
# Get them from https://polymarket.com/settings?tab=builder
# BUILDER_API_KEY=<uuid>
# BUILDER_SECRET=<base64>
# BUILDER_PASSPHRASE=<hex>
# RELAYER_HOST=https://relayer-v2.polymarket.com

# --- Polymarket Relayer API key (optional, preferred) ---
# Dedicated key that grants UNLIMITED daily relayer transactions for the
# owning wallet, bypassing the Builder-tier daily quota (100 → 10 000 tx/day).
# Required only if you hit "quota exceeded: 0 units remaining" 429 errors.
# Create one at polymarket.com → Settings → API Keys → Relayer API Keys.
# RELAYER_API_KEY=<uuid>
# RELAYER_API_KEY_ADDRESS=0x<signer-address>   # EOA that owns the key (defaults to FUNDER_ADDRESS)
